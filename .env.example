# Copy to .env.local and adjust. `.env.local` is git-ignored.

# Run the app on generated sample data, with demo sign-in (no backend needed).
# Set to 0 or remove to use the real Wyre backend.
NEXT_PUBLIC_WYRE_DEMO=1

# Wyre backend the server-side proxy forwards /api/* to (default shown).
# WYRE_BACKEND_URL=https://backend.wyreng.com

# Host for media files the API returns as relative paths, e.g. client logos.
# NEXT_PUBLIC_WYRE_MEDIA_URL=https://backend.wyreng.com
